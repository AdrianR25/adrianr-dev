---
import Button from "../components/Button.astro";
import IconFastArrowDown from "../components/icons/IconFastArrowDown.astro";
import IconSendMail from "../components/icons/IconSendMail.astro";

import { Image } from "astro:assets";
import programmingImg from "../imgs/programming.svg";
import { Size } from "../types/Size";
---

<section class="hero">
  <div class="content item">
    <header>
      <h1>Adrian R</h1>
      <h2>Software developer focused on web and mobile apps</h2>
    </header>
    <div class="content buttons">
      <Button
        variant="secondary"
        size={Size.XL}
        label="Contact"
        href="https://adrianr.dev/about"
        external={true}><IconSendMail /></Button
      >
      <Button
        variant="primary"
        size={Size.XL}
        label="Projects"
        href="https://adrianr.dev/projects"
        external={true}><IconFastArrowDown /></Button
      >
    </div>
  </div>
  <Image src={programmingImg} alt="" loading="eager" class="item"/>
</section>

<style lang="scss">
  h1,
  h2 {
    margin: 0;
  }

  header {
    > h1 {
      font-size: calc(var(--text-base-size) * 4);
      font-weight: 500;
    }
    > h2 {
      font-size: var(--text-xxxl);
      font-family: var(--font-primary);
      font-weight: 300;
    }
  }

  .hero {
    height: 100vh;

    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: var(--space-xxl);

    > img {
      max-width: 100%;
      height: auto;
    }
  }

  .content {
    display: flex;
    flex-direction: column;
  }

  .item {
    flex: 1 1 0px;
    width: 0;
  }

  .buttons {
    margin-top: var(--space-lg);
    gap: var(--space-md);
    margin-right: auto;
  }
</style>
