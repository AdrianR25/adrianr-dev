---
import type { CollectionEntry } from "astro:content";
import { Size } from "../types/Size";
import Button from "./Button.astro";
import IconGithub from "./icons/IconGithub.astro";
import IconOpenNewWindow from "./icons/IconOpenNewWindow.astro";

interface Props {
    project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<article>
    <a href={`projects/${project.id}`}>
        <header>
            <img src="https://images.ctfassets.net/tl8av3jj8ro5/6ziAXbHismN0LBMnozPJVf/31025baeedc31c293b4cadc19982a8fe/Captura_web_12-6-2023_174221_localhost.jpeg" alt="">
            <h2 class="padding-x-md padding-top-md">{ project.data.title }</h2>
        </header>
        <section class="padding-md">
            <p>{ project.data.description }</p>
            <div class="buttons padding-top-md">
                { project.data.codeUrl && <Button href={project.data.codeUrl} variant="secondary" label="See code" size={Size.MD} external={true}><IconGithub/></Button>}
                { project.data.demoUrl && <Button href={project.data.demoUrl} variant="primary" label="Live demo" size={Size.MD} external={true}><IconOpenNewWindow/></Button>}
            </div>
        </section>
    </a>
</article>

<style>
    article {
        background-color: var(--color-surface);
        
        border: 1px solid var(--color-surface);
        border-radius: var(--border-radius);

        overflow: hidden;

        display: flex;
        flex-direction: column;

        width: fit-content;
        max-width: 500px;
        height: 100%;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    h2 {
        font-family: var(--font-primary);
        margin: 0;
    }

    img {
        width: 100%;
    }

    section {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .buttons {
        display: flex;
        flex-direction: column;
        > * {
            margin-left: auto;
        }

        > *:first-of-type {
            margin-bottom: var(--space-sm);
        }
    }
</style>