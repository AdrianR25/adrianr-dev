---
const { title } = Astro.props;
---

<header>
  <svg width="100%" height="1">
    <line x1="0" y1="0" x2="100%" y2="0" stroke-width="2"></line>
  </svg>
  <h1>{title}</h1>
  <svg width="100%" height="1">
    <line x1="0" y1="0" x2="100%" y2="0" stroke-width="2"></line>
  </svg>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    > h1 {
      margin: 0;
      min-width: fit-content;
      flex-grow: 1;
    }
    > svg {
      flex-shrink: 1;
      stroke: var(--color-primary);
    }
  }
</style>
